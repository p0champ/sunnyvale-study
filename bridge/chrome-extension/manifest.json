{
  "manifest_version": 3,
  "name": "Sunnyvale Browser Bridge",
  "version": "0.2.0",
  "description": "Show your Chrome tabs inside your private Sunnyvale VR study space.",
  "minimum_chrome_version": "118",
  "permissions": [
    "debugger",
    "tabs",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "connect.html"
  },
  "key": ""
}
